{
  "name": "anonymize-sdk",
  "version": "0.1.0",
  "description": "Reversible PII pseudonymization for AI egress — text, JSON request bodies, documents (local OCR) and images (pixel redaction). Detect, mask, send, re-hydrate.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pseudonymize": "./src/pseudonymize.ts",
    "./patterns": "./src/patterns.ts",
    "./terms": "./src/terms.ts",
    "./wire": "./src/wire.ts",
    "./pipeline": "./src/pipeline.ts",
    "./ocr": "./src/documents/ocr.ts",
    "./redact-image": "./src/documents/redact-image.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tsx test/pseudonymize.test.ts && tsx test/terms.test.ts && tsx test/pipeline.test.ts && tsx test/ocr.test.ts && tsx test/redact-image.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pii",
    "anonymization",
    "pseudonymization",
    "redaction",
    "privacy",
    "llm",
    "ocr",
    "gateway",
    "gdpr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dekel-finance/anonymize-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
